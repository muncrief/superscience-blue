# PKGBUILD (SuperScience Blue, packaging/local)
# Created: 2026-09-28 04:55 | Last change: 2026-09-28 05:15 — installs the login entry that
# styles libadwaita apps automatically; pkgrel 2.
# Builds the package from this source tree (for testing before a release).
# The AUR PKGBUILD installs the same files from a GitHub release instead.
# Usage, from this folder: makepkg -si
#
# Maintainer: Robert Muncrief <siflaj@searingtruth.com>

pkgname=superscience-blue-gtk-theme
pkgver=1.0.0
pkgrel=2
pkgdesc="A clean blue theme for GTK2, GTK3, GTK4/libadwaita and Xfwm4"
arch=('any')
url="https://github.com/muncrief/superscience-blue"
license=('GPL-3.0-or-later')
optdepends=('gtk-engine-murrine: GTK2 apps'
            'gnome-themes-extra: GTK2 apps (Adwaita engine)')
install="$pkgname.install"
source=()

package()
{
    local root="$startdir/../.."
    local dest="$pkgdir/usr/share/themes/SuperScience Blue"

    install -d "$dest"
    cp -r --no-preserve=mode,ownership "$root/theme/." "$dest/"
    # g-s: the source folders may be setgid (they are in Storage); installed ones mustn't be
    find "$dest" -type d -exec chmod u=rwx,go=rx,g-s {} +
    find "$dest" -type f -exec chmod 644 {} +

    install -Dm755 "$root/bin/superscience-blue-libadwaita" "$pkgdir/usr/bin/superscience-blue-libadwaita"
    install -Dm644 "$root/packaging/superscience-blue-libadwaita.desktop" \
        "$pkgdir/etc/xdg/autostart/superscience-blue-libadwaita.desktop"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

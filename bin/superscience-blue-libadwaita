#!/bin/bash
#
# superscience-blue-libadwaita (SuperScience Blue)
# Created: 2026-09-28 04:30 | Last change: 2026-09-29 16:38 — "auto" also enables for
# SuperScience Blue-Dark (same libadwaita.css; its dark block applies when the
# desktop asks for dark). Previous entry: added "auto", run at every login by
# /etc/xdg/autostart/superscience-blue-libadwaita.desktop.
#
# Turns SuperScience Blue on or off for libadwaita apps, for the user who runs it.
#
# libadwaita apps ignore GTK themes. The only file they read is the per-user
# ~/.config/gtk-4.0/gtk.css (the name is fixed by GTK). This command makes that
# file a link to the theme's libadwaita.css. It never replaces a gtk.css that
# isn't its own link.
#
# Usage: superscience-blue-libadwaita enable|disable|status|auto
#   auto: enable if SuperScience Blue or SuperScience Blue-Dark is the
#         selected GTK theme, otherwise remove our link. Does nothing if the
#         selected theme can't be read.
#
# Copyright (C) 2026 Robert Muncrief. License: GPL-3.0-or-later.
#
set -o nounset

readonly GC_THEME_NAME="SuperScience Blue"
readonly GC_THEME_CSS="/usr/share/themes/$GC_THEME_NAME/gtk-4.0/libadwaita.css"
readonly GC_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0"
readonly GC_LINK="$GC_CONFIG_DIR/gtk.css"
readonly GC_OURS_SUFFIX="/$GC_THEME_NAME/gtk-4.0/libadwaita.css"

#
# Function: IsOurLink
# Output:   returns 0 if GC_LINK is a symlink to a SuperScience Blue libadwaita.css
#
IsOurLink()
{
    [ -L "$GC_LINK" ] || return 1
    local l_target
    l_target="$(readlink "$GC_LINK")"
    [ "${l_target%"$GC_OURS_SUFFIX"}" != "$l_target" ]
}

#
# Function: SelectedTheme
# Output:   prints the user's selected GTK theme name; returns 1 if unknown.
#           Xfce keeps it in xfconf; GNOME, Cinnamon, Budgie and MATE in
#           gsettings; KDE and others write it to gtk-3.0/settings.ini.
#
SelectedTheme()
{
    local l_name=""
    case "${XDG_CURRENT_DESKTOP:-}" in
        *XFCE*)
            command -v xfconf-query >/dev/null &&
                l_name="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null)"
            ;;
    esac
    if [ -z "$l_name" ] && command -v gsettings >/dev/null
    then
        l_name="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)"
        l_name="${l_name#\'}"
        l_name="${l_name%\'}"
    fi
    if [ -z "$l_name" ]
    then
        l_name="$(sed -n 's/^[[:space:]]*gtk-theme-name[[:space:]]*=[[:space:]]*//p' \
            "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" 2>/dev/null | tail -1)"
    fi
    [ -n "$l_name" ] || return 1
    printf '%s\n' "$l_name"
}

DoStatus()
{
    if IsOurLink
    then
        echo "Enabled: $GC_LINK -> $(readlink "$GC_LINK")"
    elif [ -e "$GC_LINK" ] || [ -L "$GC_LINK" ]
    then
        echo "Not enabled: $GC_LINK exists but isn't SuperScience Blue's link."
    else
        echo "Not enabled."
    fi
}

DoEnable()
{
    if IsOurLink
    then
        echo "Already enabled: $GC_LINK -> $(readlink "$GC_LINK")"
        return 0
    fi
    if [ -e "$GC_LINK" ] || [ -L "$GC_LINK" ]
    then
        echo "Not changed: $GC_LINK already exists and isn't SuperScience Blue's link." >&2
        echo "Move it aside yourself, then run this again." >&2
        return 1
    fi
    if [ ! -f "$GC_THEME_CSS" ]
    then
        echo "Theme not installed: $GC_THEME_CSS not found." >&2
        return 1
    fi
    mkdir -p "$GC_CONFIG_DIR" || return 1
    ln -s "$GC_THEME_CSS" "$GC_LINK" || return 1
    echo "Enabled: $GC_LINK -> $GC_THEME_CSS"
    echo "Restart libadwaita apps to see the change."
}

DoDisable()
{
    if IsOurLink
    then
        rm "$GC_LINK" || return 1
        echo "Disabled. libadwaita apps will use their default look after a restart."
    elif [ -e "$GC_LINK" ] || [ -L "$GC_LINK" ]
    then
        echo "Not changed: $GC_LINK isn't SuperScience Blue's link." >&2
        return 1
    else
        echo "Already disabled."
    fi
}

DoAuto()
{
    local l_theme
    l_theme="$(SelectedTheme)" || return 0
    if [ "$l_theme" = "$GC_THEME_NAME" ] || [ "$l_theme" = "$GC_THEME_NAME-Dark" ]
    then
        # A user's own gtk.css is left alone; only create the link if none exists
        if ! IsOurLink && [ ! -e "$GC_LINK" ] && [ ! -L "$GC_LINK" ] && [ -f "$GC_THEME_CSS" ]
        then
            DoEnable
        fi
    elif IsOurLink
    then
        DoDisable
    fi
    return 0
}

if [ "$(id -u)" -eq 0 ]
then
    echo "Run this as your normal user, not root. It only changes your own ~/.config." >&2
    exit 1
fi

case "${1:-}" in
    enable)  DoEnable ;;
    disable) DoDisable ;;
    status)  DoStatus ;;
    auto)    DoAuto ;;
    *)
        echo "Usage: superscience-blue-libadwaita enable|disable|status|auto" >&2
        exit 2
        ;;
esac
